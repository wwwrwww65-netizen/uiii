# *<! ------ App Configuration ------!>*
APP_NAME="Label StoreMax"
APP_ENV="developing"
APP_DEBUG="true"
APP_URL="https://your-woocommerce-store.com"
API_BASE_URL="https://your-woocommerce-store.com"

ASSET_PATH_PUBLIC="public/"
ASSET_PATH_IMAGES="public/images"
TIMEZONE="UTC"

LIGHT_THEME_ID="default_light_theme"
DARK_THEME_ID="default_dark_theme"

# *<! ------ Language Configuration ------!>*
DEFAULT_LOCALE="en"

# *<! ------ WooSignal Configuration ------!>*
# Get your APP_KEY from: https://woosignal.com/dashboard
APP_KEY="your_woosignal_app_key_here"

# Encryption (optional)
ENCRYPT_KEY=null
ENCRYPT_SECRET=null

# *<! ------ Firebase Configuration ------!>*
DISABLE_FIREBASE=true
FCM_ENABLED=false

# *<! ------ Payment Gateways ------!>*
# Stripe
STRIPE_LIVE_MODE=false
STRIPE_ACCOUNT=""

# PayPal
PAYPAL_LIVE_MODE=false
PAYPAL_CLIENT_ID=""
PAYPAL_SECRET_KEY=""

# RazorPay
RAZORPAY_API_KEY=""

# *<! ------ AdMob ------!>*
ADMOB_APP_ID_ANDROID=""
ADMOB_APP_ID_IOS=""

# *<! ------ Images ------!>*
PRODUCT_PLACEHOLDER_IMAGE="public/images/placeholder.png"