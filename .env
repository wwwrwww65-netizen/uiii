# Local Development Configuration
# This file is for testing the app without WooSignal/Firebase

APP_NAME="Label StoreMax (Local)"
APP_ENV="local"
APP_DEBUG="true"
APP_URL="https://demo.woosignal.com"
API_BASE_URL="https://demo.woosignal.com"

ASSET_PATH_PUBLIC="public/"
ASSET_PATH_IMAGES="public/images"
TIMEZONE="UTC"

LIGHT_THEME_ID="default_light_theme"
DARK_THEME_ID="default_dark_theme"

DEFAULT_LOCALE="en"

# Demo WooSignal Key (for testing only)
APP_KEY="demo_key_for_testing"

ENCRYPT_KEY=null
ENCRYPT_SECRET=null

# Disable external services for local testing
DISABLE_FIREBASE=true
FCM_ENABLED=false

# Payment gateways (disabled for local testing)
STRIPE_LIVE_MODE=false
STRIPE_ACCOUNT=""

PAYPAL_LIVE_MODE=false
PAYPAL_CLIENT_ID=""
PAYPAL_SECRET_KEY=""

RAZORPAY_API_KEY=""

ADMOB_APP_ID_ANDROID=""
ADMOB_APP_ID_IOS=""

PRODUCT_PLACEHOLDER_IMAGE="public/images/placeholder.png"